#!/usr/bin/env bash
set -eu
cd "$(dirname "${BASH_SOURCE[0]}")"

if docker compose version &> /dev/null; then
  DOCKER_COMPOSE_CMD="docker compose"
else
  DOCKER_COMPOSE_CMD="docker-compose"
fi

$DOCKER_COMPOSE_CMD up -d --remove-orphans
$DOCKER_COMPOSE_CMD ps

if [ "${TARGET_DB:-}" = "mssql" ]; then
  mssql_container=$($DOCKER_COMPOSE_CMD ps -q mssql)
  for attempt in {1..60}; do
    mssql_health=$(docker inspect --format '{{.State.Health.Status}}' "$mssql_container")
    [ "$mssql_health" = "healthy" ] && break
    if [ "$mssql_health" = "unhealthy" ] || [ "$attempt" = 60 ]; then
      echo "SQL Server did not become healthy" >&2
      exit 1
    fi
    sleep 1
  done
fi

bundle

echo "Creating databases..."

rails db:reset
